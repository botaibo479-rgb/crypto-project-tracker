# Copy to .env on the deployment host only. Never commit real values.
SIGNAL_DOMAIN=signal.example.com
SIGNAL_LOGIN=reader
# Generate interactively: docker run --rm -it caddy:2-alpine caddy hash-password
# Single quotes preserve dollar signs in a bcrypt hash in Docker Compose .env files.
SIGNAL_PASSWORD_HASH='REPLACE_WITH_BCRYPT_HASH'
OPENNEWS_TOKEN=REPLACE_WITH_EXISTING_TOKEN
